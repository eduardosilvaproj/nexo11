{
  "expo": {
    "name": "NEXO Operacional",
    "slug": "nexo-operacional",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nexo.operacional",
      "infoPlist": {
        "NSCameraUsageDescription": "Precisamos de acesso à câmera para anexar evidências operacionais.",
        "NSPhotoLibraryUsageDescription": "Precisamos de acesso à galeria para selecionar anexos.",
        "NSLocationWhenInUseUsageDescription": "Usamos sua localização para registrar o ponto e entregas."
      }
    },
    "android": {
      "package": "com.nexo.operacional",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "O app precisa acessar suas fotos para anexar evidências."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "your-project-id"
      }
    }
  }
}
